              "(5.5, 5.5)"
            ]
          }
        }
      ],
      "source": [
        "x = list(range(12))\n",
        "mean(x), mean2(x)"
      ],
      "id": "55db962a-6094-48b3-810c-fa1ac8d2bbd6"
