   "outputs": [],
   "source": [
    "def mean(x):\n",
    "    t = 0.0\n",
    "    N = len(x)\n",
    "    for n in range(N):\n",
    "        t += x[n]\n",
    "    return t / N\n",
    "\n",
    "def mean2(x):\n",
    "    t = 0.0\n",
    "    for xn in x:\n",
    "        t += xn\n",
    "    return t / len(x)"
   ]
  },
  {
